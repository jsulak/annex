#!/usr/bin/env bash
set -euo pipefail

export DIGITALOCEAN_TOKEN="dop_v1_..."
export SESSION_SECRET="change-me-generate-with-openssl-rand-hex-32"

# SSH key name in DigitalOcean (also used as ~/.ssh/<name> for the private key)
export TF_VAR_ssh_key_name="your-ssh-key-name"

# Debian 12 is the default. Opt into Debian 13 for a new test droplet with separate Terraform state.
# export TF_VAR_droplet_image="debian-13-x64"

# Required HTTPS hostname. Point its DNS record at the droplet.
export DOMAIN=""

# ── Usage ─────────────────────────────────────────────────
# First-time setup (new droplet): create infrastructure and pin its SSH
# host key in ~/.ssh/known_hosts using the trusted console before provisioning.
#   ./deploy.sh init  # pauses for host-key pinning
#
# Re-provision existing droplet (e.g. update Caddy config):
#   ./deploy.sh provision
#
# Deploy the app (full — includes npm ci, PM2 config):
#   ./deploy.sh deploy
#
# Push the app (same artifact deployment as deploy):
#   ./deploy.sh push
#
# Set/reset the login password:
#   ./deploy.sh setup
#
# Full teardown and rebuild:
#   ./deploy.sh destroy
#   ./deploy.sh init

case "${1:-}" in
  init)
    make infra-init
    make infra-apply
    echo "Pin the droplet's verified SSH host key in ~/.ssh/known_hosts."
    read -r -p "Press Enter after pinning the host key. "
    make wait-for-ssh
    FIRST_RUN=1 make provision
    make deploy
    make setup
    ;;
  provision)
    make provision
    ;;
  deploy)
    make deploy
    ;;
  push)
    make push
    ;;
  destroy)
    make infra-destroy
    ;;
  setup)
    make setup
    ;;
  *)
    echo "Usage: $0 {init|provision|deploy|push|setup|destroy}"
    exit 1
    ;;
esac
